{
  "$schema": "https://biomejs.dev/schemas/2.3.9/schema.json",
  "root": true,
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/Vettvangur.Site/**",
      "!**/Vettvangur.Core/**",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/.astro/**",
      "!**/.vscode/**",
      "!**/docs/**",
      "!**/src/scripts/libs/**",
      "!**/src/__tests__/**",
      "!**/src/tests/**",
      "!**/tests/fixtures/**",
      "!**/src/assets/**",
      "!**/tsconfig.json",
      "!biome.json",
      "!**/biome.json",
      "!**/esbuild.config.mjs",
      "!**/README.md",
      "!**/pnpm-lock.yaml",
      "!**/localhost-key.pem",
      "!**/localhost.pem",
      "!**/.gitignore",
      "!**/readme",
      "!**/src/scripts/utility/validation/**",
      "!**/public/**",
      "!**/src/styles/**"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noAutofocus": "error",
        "noPositiveTabindex": "error",
        "useAltText": "error",
        "useAnchorContent": "error",
        "useButtonType": "error",
        "useKeyWithClickEvents": "warn",
        "useKeyWithMouseEvents": "off",
        "useValidAnchor": "error"
      },
      "complexity": {
        "noArguments": "error",
        "noExtraBooleanCast": "error",
        "noAdjacentSpacesInRegex": "error",
        "noUselessFragments": "error",
        "useFlatMap": "warn",
        "useOptionalChain": "off",
        "useSimplifiedLogicExpression": "off",
        "noForEach": "off",
        "useWhile": "warn",
        "useArrowFunction": "off",
        "noUselessTernary": "off",
        "noUselessEscapeInRegex": "off"
      },
      "correctness": {
        "noChildrenProp": "error",
        "noConstAssign": "error",
        "noEmptyPattern": "off",
        "noRenderReturnValue": "error",
        "noUndeclaredVariables": "off",
        "noUnreachable": "error",
        "noUnusedVariables": "error",
        "noVoidElementsWithChildren": "error",
        "useValidForDirection": "error",
        "useValidTypeof": "error",
        "useParseIntRadix": "off"
      },
      "performance": {
        "noDelete": "error"
      },
      "security": {
        "noBlankTarget": "error",
        "noDangerouslySetInnerHtml": "off",
        "noDangerouslySetInnerHtmlWithChildren": "off"
      },
      "style": {
        "noImplicitBoolean": "off",
        "noNegationElse": "off",
        "noShoutyConstants": "off",
        "noUnusedTemplateLiteral": "error",
        "useBlockStatements": "error",
        "useFragmentSyntax": "off",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "warn",
        "noParameterAssign": "off",
        "noNonNullAssertion": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noCommentText": "error",
        "noCompareNegZero": "error",
        "noDebugger": "warn",
        "noDoubleEquals": "error",
        "noDuplicateParameters": "error",
        "noExplicitAny": "off",
        "noFunctionAssign": "error",
        "noImportAssign": "error",
        "noLabelVar": "error",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "error",
        "noUnsafeNegation": "error",
        "noRedeclare": "off",
        "noImplicitAnyLet": "off",
        "noTsIgnore": "off",
        "useIterableCallbackReturn": "off",
        "useBiomeIgnoreFolder": "off",
        "noAssignInExpressions": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svelte", "**/*.astro", "**/*.vue"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
