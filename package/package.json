{
  "name": "@bgunnarsson/toaster",
  "version": "1.0.0",
  "description": "Toast message javascript library",
  "access": "private",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "toast",
    "messages",
    "toast messages"
  ],
  "author": "B. Gunnarsson | www.bgunnarsson.com",
  "license": "ISC",
  "main": "./dist/index.esm.js",
  "types": "./dist/types/index.d.mts",
  "files": [
    "dist",
    "toaster-logo.png"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.mts",
      "default": "./dist/index.esm.js"
    },
    "./react": {
      "types": "./dist/types/react.d.mts",
      "default": "./dist/react.esm.js"
    }
  },
  "scripts": {
    "bundle": "tsdown && pnpm types",
    "dist": "pnpm publish",
    "types": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "tsdown": "0.23.2",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
